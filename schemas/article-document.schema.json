{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/obsidian-feed/article-document.schema.json",
  "title": "Obsidian Feed ArticleDocument V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "sourceName", "canonicalUrl", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "subtitle": { "type": "string", "maxLength": 2000 },
    "author": { "type": "string", "maxLength": 500 },
    "sourceName": { "type": "string", "minLength": 1, "maxLength": 500 },
    "canonicalUrl": { "type": "string", "format": "uri", "maxLength": 4096 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "language": { "type": "string", "maxLength": 32 },
    "blocks": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "mark": {
      "enum": ["bold", "italic", "code", "strike"]
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "maxLength": 200000 },
        "marks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mark" }
        },
        "href": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "paragraph" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "level", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "heading" },
        "level": { "enum": [2, 3, 4] },
        "children": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "image" },
        "src": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "originalSrc": { "type": "string", "format": "uri", "maxLength": 4096 },
        "alt": { "type": "string", "maxLength": 2000 },
        "caption": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "animated": { "type": "boolean" }
      }
    },
    "blockquote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "blockquote" },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/paragraph" },
              { "$ref": "#/$defs/heading" }
            ]
          }
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "children": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "nested": { "$ref": "#/$defs/list" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "ordered", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "start": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "items": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "code"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "code" },
        "code": { "type": "string", "maxLength": 200000 },
        "language": { "type": "string", "maxLength": 100 }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "headers", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
          }
        }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "const": "divider" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/divider" }
      ]
    }
  }
}
