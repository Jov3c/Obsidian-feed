# Generate with: openssl rand -hex 32
FEED_SERVER_TOKEN=replace-with-at-least-32-random-characters
FEED_SERVER_URL=http://127.0.0.1:43110

# Optional WeChat integration. Attach your self-managed WeRSS container to the
# `obsidian-feed` Docker network, then uncomment all three values together.
# WECHAT_ADAPTER=werss
# WERSS_BASE_URL=http://werss:8001
# WERSS_API_KEY=replace-with-your-werss-api-key

WERSS_REQUEST_TIMEOUT_MS=15000
WECHAT_INITIAL_BACKFILL_LIMIT=30
WECHAT_SYNC_PAGE_SIZE=20
WECHAT_SYNC_MAX_PAGES=3
WECHAT_PLAYWRIGHT_ENABLED=false

SYNC_TICK_SECONDS=60
SYNC_MAX_CONCURRENCY=4
RSS_SYNC_INTERVAL_MINUTES=30
WECHAT_SYNC_INTERVAL_MINUTES=60

EXTERNAL_FETCH_MAX_BYTES=5242880
EXTERNAL_FETCH_MAX_REDIRECTS=5
MEDIA_MAX_BYTES=20971520
MEDIA_CACHE_MAX_BYTES=2147483648
MEDIA_FETCH_TIMEOUT_MS=15000
